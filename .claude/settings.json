{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-git-add-all.sh",
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-push.sh",
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/scan-secrets.sh",
            "onFailure": "block",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/require-step-comment.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-gate.sh",
            "timeout": 180,
            "statusMessage": "make check (Stop gate)..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-gate.sh",
            "timeout": 180,
            "statusMessage": "make check (Stop gate)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-context.sh",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)",
      "Bash(git add :/:*)",
      "Bash(git add -- .:*)",
      "Bash(git add -- :/:*)",
      "Bash(git commit:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label:*)",
      "Bash(gh api:*)",
      "Bash(gh -R:*)",
      "Bash(gh --repo:*)",
      "Bash(gh --repo=*)",
      "Bash(rtk gh:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --git-dir=*)",
      "Bash(git --work-tree:*)",
      "Bash(git --work-tree=*)",
      "Bash(git --no-pager -C:*)",
      "Bash(git -p -C:*)",
      "Bash(git --no-pager push:*)",
      "Bash(git -p push:*)",
      "Bash(git --no-pager add -A:*)",
      "Bash(git --no-pager add .:*)",
      "Bash(git --no-pager add --all:*)",
      "Bash(git -p add -A:*)",
      "Bash(git -p add .:*)",
      "Bash(git -p add --all:*)",
      "Bash(env:*)",
      "Bash(GIT_COMMON_DIR=*)",
      "Bash(sudo:*)",
      "Bash(nohup:*)",
      "Bash(nice:*)",
      "Bash(time:*)",
      "Bash(timeout:*)",
      "Bash(bash -lc:*)",
      "Bash(bash -c:*)",
      "Bash(scripts/agentic-flow ship:*)",
      "Bash(scripts/agentic-flow approve:*)",
      "Bash(scripts/agentic-flow hold clear:*)",
      "Bash(scripts/agentic-flow token:*)",
      "Bash(rtk proxy scripts/agentic-flow ship:*)",
      "Bash(rtk proxy scripts/agentic-flow token:*)",
      "Bash(git-claude push:*)",
      "Bash(git-claude add -A:*)",
      "Bash(git-claude add .:*)",
      "Bash(git-claude add --all:*)",
      "Bash(git-claude add :/:*)",
      "Bash(git-claude add -- .:*)",
      "Bash(git-claude add -- :/:*)",
      "Bash(git-claude commit -n:*)",
      "Bash(git-claude commit --no-verify:*)",
      "Bash(git-claude commit * -n)",
      "Bash(git-claude commit * --no-verify)",
      "Bash(git-codex push:*)",
      "Bash(git-codex add -A:*)",
      "Bash(git-codex add .:*)",
      "Bash(git-codex add --all:*)",
      "Bash(git-codex add :/:*)",
      "Bash(git-codex add -- .:*)",
      "Bash(git-codex add -- :/:*)",
      "Bash(git-codex commit -n:*)",
      "Bash(git-codex commit --no-verify:*)",
      "Bash(git-codex commit * -n)",
      "Bash(git-codex commit * --no-verify)",
      "Bash(git-opencode push:*)",
      "Bash(git-opencode add -A:*)",
      "Bash(git-opencode add .:*)",
      "Bash(git-opencode add --all:*)",
      "Bash(git-opencode add :/:*)",
      "Bash(git-opencode add -- .:*)",
      "Bash(git-opencode add -- :/:*)",
      "Bash(git-opencode commit -n:*)",
      "Bash(git-opencode commit --no-verify:*)",
      "Bash(git-opencode commit * -n)",
      "Bash(git-opencode commit * --no-verify)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-verify:*)"
    ]
  }
}

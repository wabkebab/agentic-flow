{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/block-git-add-all.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/block-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/scan-secrets.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/require-step-comment.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/check-gate.sh",
            "timeout": 180,
            "statusMessage": "make check (Stop gate)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/check-gate.sh",
            "timeout": 180,
            "statusMessage": "make check (Stop gate)..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/session-context.sh",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
